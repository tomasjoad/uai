# Copia este fichero como .env en agent-core/ (no se sube al repo).
ANTHROPIC_API_KEY=

# Opcionales
# AGENT_CORE_DATA_DIR=        # por defecto, la carpeta de datos del usuario (%LOCALAPPDATA%\agent-core en Windows)
# AGENT_CORE_PORT=8765
# AGENT_CORE_MAX_ITERATIONS=6
# AGENT_CORE_ALLOWED_ORIGINS= # orígenes de navegador permitidos, separados por comas (p.ej. la carcasa Tauri)
